import { Box, SimpleGrid, Text, Heading, Icon } from '@chakra-ui/react';
import { RiLineChartLine, RiAlarmWarningLine, RiQuestionLine } from 'react-icons/ri';

const PURPLE = {
  bg:         '#1e1245',
  card:       '#271758',
  cardBorder: '#3d2a8a',
  accent:     '#7c5cf6',
  accentSoft: '#a78bf8',
  muted:      '#9d8fd4',
  headingFg:  '#ffffff',
};

const PAIN_POINTS = [
  {
    icon: RiLineChartLine,
    iconBg: 'rgba(39,174,96,0.18)',
    iconColor: '#4eca80',
    title: 'Income hits differently every month',
    description: 'A $12k month followed by a $1.5k month makes it impossible to know what you can actually afford.',
  },
  {
    icon: RiAlarmWarningLine,
    iconBg: 'rgba(212,168,0,0.18)',
    iconColor: '#fbbf24',
    title: 'Tax time is a nightmare',
    description: "You spend freely all year then get hit with a surprise tax bill. Sound familiar? You're not alone.",
  },
  {
    icon: RiQuestionLine,
    iconBg: 'rgba(124,92,246,0.22)',
    iconColor: '#a78bf8',
    title: '"Can I spend this?" is unanswerable',
    description: "You check your bank balance but that number lies. It doesn't account for tax, emergencies, or slow months ahead.",
  },
];

export function ProblemSection() {
  return (
    <Box
      id="problem"
      bg={PURPLE.bg}
      py={{ base: 16, md: 24 }}
      position="relative"
    >
      <Box position="absolute" top="40px" left="5%" w="500px" h="500px" borderRadius="full"
        bg="radial-gradient(circle, rgba(124,92,246,0.18) 0%, transparent 65%)" pointerEvents="none" />
      <Box position="absolute" bottom="200px" right="5%" w="400px" h="400px" borderRadius="full"
        bg="radial-gradient(circle, rgba(76,95,213,0.12) 0%, transparent 65%)" pointerEvents="none" />

      <Box maxW="1100px" mx="auto" px={{ base: 5, md: 8 }} position="relative">
        <Text
          fontSize="11px" fontWeight="700" color={PURPLE.accentSoft}
          textTransform="uppercase" letterSpacing="1.5px"
          textAlign="center" mb={4}
        >
          The freelancer problem
        </Text>

        <Heading
          as="h2"
          fontFamily="'Fraunces', Georgia, serif"
          fontSize={{ base: '30px', md: '40px' }}
          fontWeight="800"
          textAlign="center"
          letterSpacing="-1.5px"
          color={PURPLE.headingFg}
          mb={4}
        >
          Your bank balance is a liar.
        </Heading>

        <Text
          textAlign="center" fontSize="17px" color={PURPLE.muted}
          maxW="520px" mx="auto" lineHeight="1.65" mb={14}
        >
          It doesn't know about your tax bill, your dry month coming up,
          or the emergency buffer you promised yourself you'd keep.
        </Text>

        <SimpleGrid columns={{ base: 1, md: 3 }} spacing={6}>
          {PAIN_POINTS.map((point) => (
            <Box
              key={point.title}
              p={7}
              bg={PURPLE.card}
              borderRadius="16px"
              border="1px solid"
              borderColor={PURPLE.cardBorder}
              position="relative"
              overflow="hidden"
              _hover={{
                transform: 'translateY(-4px)',
                boxShadow: '0 20px 48px rgba(0,0,0,0.35)',
                borderColor: PURPLE.accent,
              }}
              transition="all 0.22s"
            >
              {/* Top accent line */}
              <Box
                position="absolute" top={0} left={0} right={0} h="3px"
                bg={`linear-gradient(90deg, ${point.iconColor}cc, transparent)`}
              />

              {/* Icon */}
              <Box
                w="44px" h="44px" borderRadius="12px"
                bg={point.iconBg}
                display="flex" alignItems="center" justifyContent="center"
                mb={5}
              >
                <Icon as={point.icon} color={point.iconColor} boxSize="20px" />
              </Box>

              <Text
                fontWeight="700" fontSize="16px"
                color={PURPLE.headingFg} letterSpacing="-0.3px"
                lineHeight="1.3" mb={3}
              >
                {point.title}
              </Text>
              <Text fontSize="14px" color={PURPLE.muted} lineHeight="1.65">
                {point.description}
              </Text>
            </Box>
          ))}
        </SimpleGrid>

        <Box
          mt={14} p={6}
          bg="rgba(124,92,246,0.15)"
          borderRadius="14px"
          border="1px solid rgba(124,92,246,0.35)"
          textAlign="center"
        >
          <Text fontSize="18px" fontWeight="700" color={PURPLE.headingFg} letterSpacing="-0.3px" mb={2}
            fontFamily="'Fraunces', Georgia, serif">
            There's a better question to ask.
          </Text>
          <Text fontSize="15px" color={PURPLE.muted}>
            Not <Box as="span" fontStyle="italic">"what's in my account?"</Box> but{' '}
            <Box as="span" fontWeight="700" color={PURPLE.accentSoft}>
              "what can I safely spend right now?"
            </Box>
          </Text>
        </Box>
      </Box>
    </Box>
  );
}
