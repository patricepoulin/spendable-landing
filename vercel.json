{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.spendable.finance" }],
      "destination": "https://spendable.finance/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "/sitemap.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
